---
import Logo from './Logo.astro';

interface Props {
  hideCta?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
  showPartnerLink?: boolean;
}

const base = import.meta.env.BASE_URL;
const {
  hideCta = false,
  ctaLabel = 'Angebot anfordern',
  ctaHref = `${base}#anfrage`,
  showPartnerLink = false,
} = Astro.props;
---
<header>
  <div class="subheader">
    <div class="wrap subheader-in">
      <ul class="subheader-claim">
        <li>Aus Leidenschaft</li>
        <li>Österreichweit</li>
        <li>Säurefreie Verfahren</li>
        <li>Professionelle Ergebnisse</li>
      </ul>
      <p class="subheader-kontakt">
        <span class="subheader-zeit">Mo–Do 7.30–17 Uhr · Fr 7.30–14 Uhr</span>
        <a href="mailto:office@123reinigung.at">office@123reinigung.at</a>
      </p>
    </div>
  </div>
  <div class="wrap bar">
    <a class="logo" href={base}>
      <Logo />
    </a>
    <nav class="nav">
      <a href={`${base}leistungen`}>Leistungen</a>
      <a href={`${base}#ablauf`}>Ablauf</a>
      <a href={`${base}#fragen`}>Fragen</a>
      <a href={`${base}kontakt`}>Kontakt</a>
      {showPartnerLink && <a href={`${base}franchise`} class="nav-partner-link">Franchise-Partner werden</a>}
    </nav>
    <div class="header-actions">
      {!hideCta && <a class="btn btn--sm header-cta" href={ctaHref}>{ctaLabel}</a>}
      <button class="nav-toggle" type="button" id="navToggle" aria-expanded="false" aria-controls="mobileNav" aria-label="Menü öffnen">
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobileNav" aria-label="Mobile Navigation">
    <a href={`${base}leistungen`}>Leistungen</a>
    <a href={`${base}#ablauf`}>Ablauf</a>
    <a href={`${base}#fragen`}>Fragen</a>
    <a href={`${base}kontakt`}>Kontakt</a>
    {showPartnerLink && <a href={`${base}franchise`} class="mobile-nav-partner-link">Franchise-Partner werden</a>}
    {!hideCta && <a href={ctaHref} class="mobile-nav-cta">{ctaLabel}</a>}
  </nav>
</header>

<script>
  (function () {
    var toggle = document.getElementById('navToggle');
    var panel = document.getElementById('mobileNav');
    if (!toggle || !panel) return;

    function closeMenu() {
      panel.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    }
    function openMenu() {
      panel.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
    }

    toggle.addEventListener('click', function () {
      if (panel.classList.contains('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    panel.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeMenu);
    });

    document.addEventListener('click', function (e) {
      if (!panel.classList.contains('is-open')) return;
      var target = e.target as Node;
      if (panel.contains(target) || toggle.contains(target)) return;
      closeMenu();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeMenu();
    });
  })();
</script>
