---
import { brand } from '../config/brand';

const base = import.meta.env.BASE_URL;
---
<footer>
  <div class="wrap">
    <div class="fgrid">
      <div>
        <h4>{brand.name}</h4>
        <p style="max-width:34ch">Spezialisierte Gebäudereinigung — {brand.tagline}. Photovoltaik, Marmor und Naturstein, Pflasterflächen. Österreichweit.</p>
        <div class="franchise-link">
          <b>Sie möchten selbst Partner werden?</b><br>
          <a href={`${base}franchise`}>Franchise-Partner werden</a>
        </div>
      </div>
      <div>
        <h4>Kontakt</h4>
        <p>
          {brand.unternehmen.firmenwortlaut}<br>
          {brand.unternehmen.strasse}<br>
          {brand.unternehmen.plz} {brand.unternehmen.ort}
        </p>
        <a href={`tel:${brand.unternehmen.telefon}`}>{brand.unternehmen.telefonAnzeige}</a>
        <a href={`mailto:${brand.email}`}>{brand.email}</a>
      </div>
      <div>
        <h4>Rechtliches</h4>
        <a href={`${base}impressum`}>Impressum</a>
        <a href={`${base}datenschutz`}>Datenschutz</a>
      </div>
    </div>
    <div class="fbottom">
      <p>© {new Date().getFullYear()} {brand.name}</p>
    </div>
  </div>
</footer>
