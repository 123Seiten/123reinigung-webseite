---
import InhaltsBild from './InhaltsBild.astro';
import type { BildKey } from '../config/bilder';

interface Props {
  vorher: BildKey;
  nachher: BildKey;
  /** Zeile über dem Bild, z. B. "Privatgarten · Natursteinterrasse" */
  objekt: string;
  /** Beschreibung unter dem Label */
  text: string;
}

const { vorher, nachher, objekt, text } = Astro.props;

// Aus dem CSS gerechnet, nicht geschätzt (siehe AENDERUNGEN-PROMPT-7.md, 2.2):
// .cases bricht bei 820px auf drei Spalten um (global.css); Desktop-Kartenbreite
// dort ≈306px, mobil volle Breite minus Wrap- und Kartenpolsterung.
const vnWidths = [400, 600, 800];
const vnSizes = '(max-width: 820px) calc(100vw - 88px), 306px';
---
<div class="case" data-zustand="vorher">
  <p class="meta">{objekt}</p>

  <div class="vn" tabindex="0" role="button" aria-label="Vorher-Nachher-Vergleich umschalten">
    <InhaltsBild eintrag={vorher} class="vn-vorher" loading="lazy" widths={vnWidths} sizes={vnSizes} />
    <InhaltsBild eintrag={nachher} class="vn-nachher" loading="lazy" widths={vnWidths} sizes={vnSizes} />
  </div>

  <div class="vn-label" aria-hidden="true">
    <span class="vn-punkt"></span>
    <span class="vn-status vn-status--vorher">Vorher</span>
    <span class="vn-status vn-status--nachher">Nachher</span>
  </div>

  <p class="vn-text">{text}</p>
</div>
