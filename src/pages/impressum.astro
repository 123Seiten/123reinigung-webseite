---
import Layout from '../layouts/Layout.astro';
import { brand } from '../config/brand';
import { BILDER, BILDQUELLEN_LIZENZ } from '../config/bilder';

const bildEintraege = Object.values(BILDER);
const quellen = [...new Set(bildEintraege.map((b) => b.quelle))];
---

<Layout title={`Impressum – ${brand.name}`}>
  <section class="band">
    <div class="wrap">
      <div class="rule"></div>
      <h1 class="display">Impressum</h1>
      <p class="lead">Angaben gemäß § 5 ECG, § 14 UGB, § 63 GewO und § 25 MedienG.</p>

      <div class="legal">
        <div class="legal-section">
          <h3 class="display">Diensteanbieter</h3>
          <p>
            {brand.unternehmen.firmenwortlaut} i. G.<br>
            {brand.unternehmen.strasse}<br>
            {brand.unternehmen.plz} {brand.unternehmen.ort}<br>
            {brand.unternehmen.land}
          </p>
          <p>
            23.09.2026: Die 123Reinigung Franchise GmbH befindet sich zum heutigen Zeitpunkt in der Gründungsphase. Fehlende Angaben, wie Firmenbuchnummer, Steuernummer, werden nachgereicht, sobald diese vorliegen.
          </p>
          {brand.unternehmen.firmenbuchnummer && <p>Firmenbuchnummer: {brand.unternehmen.firmenbuchnummer}</p>}
          {brand.unternehmen.firmenbuchgericht && <p>Firmenbuchgericht: {brand.unternehmen.firmenbuchgericht}</p>}
          {brand.unternehmen.uid && <p>UID-Nummer: {brand.unternehmen.uid}</p>}
        </div>

        <div class="legal-section">
          <h3 class="display">Vertretungsberechtigte Geschäftsführung</h3>
          <p>{brand.unternehmen.geschaeftsfuehrung}</p>
        </div>

        <div class="legal-section">
          <h3 class="display">Kontakt</h3>
          <p>
            Telefon: <a href={`tel:${brand.unternehmen.telefon}`}>{brand.unternehmen.telefonAnzeige}</a><br>
            E-Mail: <a href={`mailto:${brand.email}`}>{brand.email}</a>
          </p>
        </div>

        <div class="legal-section">
          <h3 class="display">Unternehmensgegenstand</h3>
          <p>{brand.unternehmen.unternehmensgegenstand}</p>
        </div>

        <div class="legal-section">
          <h3 class="display">Mitgliedschaften</h3>
          <p>
            {brand.unternehmen.kammer && <>Mitglied der {brand.unternehmen.kammer}<br /></>}
            Anwendbare Rechtsvorschriften: Gewerbeordnung (<a href="https://www.ris.bka.gv.at" target="_blank" rel="noopener">www.ris.bka.gv.at</a>)
          </p>
        </div>

        <div class="legal-section">
          <h3 class="display">Berufsbezeichnung</h3>
          <p>
            {brand.unternehmen.berufsbezeichnung}<br>
            Verliehen in {brand.unternehmen.verleihungsstaat}
          </p>
        </div>

        <div class="legal-section">
          <h3 class="display">Behörde gemäß ECG</h3>
          <p>{brand.unternehmen.aufsichtsbehoerde}</p>
        </div>

        <div class="legal-section">
          <h3 class="display">EU-Streitschlichtung</h3>
          <p>
            Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit, abrufbar unter{' '}
            <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener">ec.europa.eu/consumers/odr</a>.
          </p>
          <p>
            Wir sind weder bereit noch verpflichtet, an einem Streitbeilegungsverfahren vor einer
            Verbraucherschlichtungsstelle teilzunehmen.
          </p>
        </div>

        {bildEintraege.length > 0 && (
          <div class="legal-section">
            <h3 class="display">Bildquellen</h3>
            {quellen.map((quelle) => {
              const lizenz = BILDQUELLEN_LIZENZ[quelle];
              return <p>Bildmaterial: {quelle}{lizenz && ` (${lizenz})`}.</p>;
            })}
            <p>
              {bildEintraege.map((bild, i) => (
                <>
                  {bild.beschreibung} ({bild.quelle}{bild.kiGeneriert && ', mit KI erstellt'})
                  {i < bildEintraege.length - 1 && <br />}
                </>
              ))}
            </p>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
