---
import Layout from '../layouts/Layout.astro';
import TileSelect from '../components/TileSelect.astro';
import FranchiseBewerbung from '../components/FranchiseBewerbung.astro';
import { brand } from '../config/brand';

const base = import.meta.env.BASE_URL;

const regionen = [
  'Burgenland',
  'Kärnten',
  'Niederösterreich',
  'Oberösterreich',
  'Salzburg',
  'Steiermark',
  'Tirol',
  'Vorarlberg',
  'Wien',
].map((name) => ({ value: name, label: name }));
---

<Layout
  title={`Franchise-Partner werden – ${brand.name}`}
  description="Spezialisierte Gebäudereinigung als Franchise: Gebietsschutz, digitale Leadgenerierung, Schulung für Stein, Fassade und PV."
  ctaLabel="Bewerbung starten"
  ctaHref="#regionen"
  stickyCtaLabel="Bewerbung starten"
  stickyCtaHref="#regionen"
>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Die Idee</p>
        <h1 class="display">Dein eigener Reinigungsbetrieb — <em>mit System dahinter.</em></h1>
        <p class="hero-sub">
          123Reinigung ist ein Franchise-System für spezialisierte Gebäudereinigung: Marmor, Stein, Fassade, Glas
          und Photovoltaik. Für bestehende Betriebe und für Quereinsteiger, die es ernst meinen.
        </p>
        <div class="hero-cta">
          <a class="btn" href="#regionen">Franchise-Unterlagen anfordern</a>
        </div>
        <p class="btn-note">Unverbindlich · Exklusiver Gebietsschutz · Digitale Kundengewinnung</p>
      </div>

      <div class="photo">
        <img
          src={`${base}placeholders/franchise-hero.svg`}
          alt="Platzhalter: Franchise-Partnerin oder -Partner im Gespräch mit einer Unternehmerin, Notebook und Unterlagen auf dem Tisch"
          width="800" height="1000"
        >
      </div>
    </div>
  </section>

  <!-- DIE IDEE -->
  <section class="band band--grey reveal">
    <div class="wrap">
      <div class="rule"></div>
      <p class="eyebrow">Die Idee</p>
      <h2 class="display">Ein Markt, der noch niemandem gehört.</h2>
      <p class="lead">
        Die Gebäudereinigungsbranche in Österreich hat ein Marktvolumen von rund 1,8 Milliarden Euro. Der
        spezialisierte Bereich — Steinpflege, Denkmalreinigung, PV-Anlagenreinigung — ist dabei kaum organisiert.
        Genau dort setzen wir an.
      </p>
    </div>
  </section>

  <!-- SECHS BAUSTEINE -->
  <section class="band band--dark reveal">
    <div class="wrap">
      <p class="eyebrow on-dark">123Reinigung</p>
      <h2 class="display">Sechs Bausteine, die zusammenspielen.</h2>

      <div class="pillars">
        <div class="pillar">
          <span class="pillar-n">1</span>
          <h3 class="display">Digitale Kundengewinnung</h3>
          <p>Leads werden automatisch generiert, statt mühsam selbst akquiriert.</p>
        </div>
        <div class="pillar">
          <span class="pillar-n">2</span>
          <h3 class="display">Digitale Auftragsverwaltung</h3>
          <p>Ein klarer, digitaler Ablauf statt Zettelwirtschaft.</p>
        </div>
        <div class="pillar">
          <span class="pillar-n">3</span>
          <h3 class="display">Digitale Mitarbeiterführung</h3>
          <p>Moderne Tools statt Excel-Listen und WhatsApp-Chaos.</p>
        </div>
        <div class="pillar">
          <span class="pillar-n">4</span>
          <h3 class="display">Digitale Firmenführung</h3>
          <p>Deine gesamte Betriebsführung auf zeitgemäßem Stand.</p>
        </div>
        <div class="pillar">
          <span class="pillar-n">5</span>
          <h3 class="display">Spezialisierungsprofil</h3>
          <p>Marmor, Stein, Fassade, PV — für jede Oberfläche.</p>
        </div>
        <div class="pillar">
          <span class="pillar-n">6</span>
          <h3 class="display">Starke Marke</h3>
          <p>Eine österreichweite Marke statt Einzelkämpfer-Dasein.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ZWEI STARKE PARTNER -->
  <section class="band reveal">
    <div class="wrap">
      <div class="rule"></div>
      <h2 class="display">Getragen von zwei starken Partnern</h2>

      <div class="fit-grid">
        <div>
          <h3 class="display" style="margin-bottom:14px">Langmann Facility Services</h3>
          <ul class="mkt-list" style="grid-template-columns:1fr;margin-top:0">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg>
              <p>Über 104 Jahre Familienerfahrung in der Gebäudereinigung.</p>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg>
              <p>Spezialisiert auf Marmor- und Steinreinigung, Fassaden, Denkmalschutz.</p>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg>
              <p>Zusammenarbeit mit führenden Steinherstellern und Lieferanten, Know-how für alle am Markt erhältlichen Steinarten und Feinsteinzeug.</p>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg>
              <p>Eigene Schulungskonzepte und technische Standards.</p>
            </li>
          </ul>
        </div>
        <div>
          <h3 class="display" style="margin-bottom:14px">UnternehmerCircle Verband</h3>
          <ul class="mkt-list" style="grid-template-columns:1fr;margin-top:0">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg>
              <p>Bundesweiter Dachverband mit Landesstrukturen in jedem Bundesland.</p>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg>
              <p>Strategische Begleitung, Zertifizierung und Sprachrohr in die österreichische Wirtschaft.</p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ALEKS+ -->
  <section class="band band--grey reveal">
    <div class="wrap">
      <div class="rule"></div>
      <p class="eyebrow">Vertriebsdigitalisierung</p>
      <h2 class="display">Der Unterschied, der zählt: Aleks+</h2>

      <div class="compare">
        <div class="compare-card">
          <p class="compare-label">Traditionell — 7 Schritte</p>
          <p>Anbahnung → Ersttermin → Bedarfsermittlung → Angebotserstellung → Angebotspräsentation → Abschlusstermin → Auftragsbearbeitung.</p>
        </div>
        <div class="compare-card is-featured">
          <p class="compare-label">Mit Aleks+ — 2 Schritte</p>
          <p>Abschlusstermin → Auftragsbearbeitung.</p>
        </div>
      </div>

      <p class="compare-note">
        Anbahnung bis Angebotspräsentation läuft automatisiert und digital. Für dich bleibt, was wirklich zählt:
        der Abschluss und die Arbeit selbst. Kürzere Verkaufszyklen, schnellere Reaktionszeiten, mehr Zeit fürs
        Handwerk.
      </p>
    </div>
  </section>

  <!-- MARKTPOTENZIAL -->
  <section class="band band--brand reveal">
    <div class="wrap">
      <p class="eyebrow on-dark" style="color:rgba(255,255,255,.8)">Marktpotenzial</p>
      <h2 class="price-claim">Ein Markt mit<br>enormer Dynamik.</h2>
      <p style="max-width:62ch;font-size:1.05rem;color:rgba(255,255,255,.92)">
        Die österreichische Gebäudereinigungsbranche erzielte 2023 einen Umsatz von rund 1,79 Milliarden Euro —
        ein Plus von 4,5&nbsp;% gegenüber dem Vorjahr. Der spezialisierte Bereich ist dabei noch weitgehend
        unorganisiert.
      </p>

      <div class="calc">
        <div>
          <p class="lbl">Branchenumsatz Österreich 2023</p>
          <p class="val num">1,79 Mrd. €</p>
          <p class="hint">+4,5 % gegenüber Vorjahr</p>
        </div>
        <div>
          <p class="lbl">Denkmalgeschützte Gebäude</p>
          <p class="val num">300.000</p>
          <p class="hint">mit Bedarf an Spezialpflege</p>
        </div>
        <div class="keep">
          <p class="lbl">Spezialisierungen im System</p>
          <p class="val">PV · Marmor · Pflaster</p>
          <p class="hint">für jede Oberfläche</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DEINE VORTEILE -->
  <section class="band reveal">
    <div class="wrap">
      <div class="rule"></div>
      <h2 class="display">Deine Vorteile als Franchise-Partner</h2>
      <ul class="mkt-list">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg><p>Starke, österreichweite Marke mit Wiedererkennungswert</p></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg><p>Digitale Kundengewinnung & Leadgenerierung über Aleks+</p></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg><p>Exklusiver Gebietsschutz in deiner Region</p></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg><p>Zugang zu führenden Produkt- & Lieferantenkonditionen</p></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg><p>Laufende Umsatz- und Marketingunterstützung</p></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg><p>Schulungen für Stein, Marmor, Fassade & PV</p></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg><p>Kalkulierbare Margen durch standardisierte Prozesse</p></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg><p>Rückhalt durch 104 Jahre Branchen-Know-how</p></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg><p>Bundesweites Unternehmernetzwerk im Rücken</p></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg><p>Begleitung durch Experten aus Holding & Verband</p></li>
      </ul>
    </div>
  </section>

  <!-- WER ZU UNS PASST -->
  <section class="band band--grey reveal">
    <div class="wrap">
      <div class="rule"></div>
      <h2 class="display">Wer zu uns passt</h2>
      <p class="lead" style="max-width:70ch">
        123Reinigung richtet sich an bestehende Reinigungsbetriebe, die ihr Profil schärfen und professionalisieren
        wollen, genauso wie an motivierte Kleinbetriebe und Quereinsteiger:innen mit einem Gespür für Sauberkeit
        und Qualität. Was vielen Betrieben bisher fehlt: strukturierte Kundengewinnung, ein digitales
        Auftragssystem und ein starker Markenauftritt. Genau das bringen wir mit.
      </p>
    </div>
  </section>

  <!-- ROADMAP -->
  <section class="band reveal">
    <div class="wrap">
      <div class="rule"></div>
      <h2 class="display">Roadmap</h2>
      <div class="terms">
        <div>
          <p class="lbl">2026</p>
          <p class="val" style="font-size:1.15rem">Aufbau erster Franchise-Partner in Österreich</p>
        </div>
        <div>
          <p class="lbl">2027</p>
          <p class="val" style="font-size:1.15rem">Österreichweiter Rollout mit 50 Partnern</p>
        </div>
        <div>
          <p class="lbl">ab 2028</p>
          <p class="val" style="font-size:1.15rem">Expansion nach Deutschland und in die Schweiz</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FRANCHISEKONDITIONEN & KOSTEN -->
  <section class="band band--grey reveal" id="konditionen">
    <div class="wrap">
      <div class="rule"></div>
      <h2 class="display">Franchisekonditionen &amp; Kosten</h2>
      <p class="lead">Die Lizenzkosten im Überblick — final abgestimmt werden sie im persönlichen Gespräch.</p>

      <div class="terms">
        <div>
          <p class="lbl">Einstiegsgebühr</p>
          <p class="val">40.000 €</p>
          <p class="hint" style="color:var(--grey-500)">netto, einmalig</p>
        </div>
        <div>
          <p class="lbl">Laufende Franchisegebühr</p>
          <p class="val">8 %</p>
          <p class="hint" style="color:var(--grey-500)">vom Nettoumsatz</p>
        </div>
        <div>
          <p class="lbl">Marketingbeitrag</p>
          <p class="val">3 %</p>
          <p class="hint" style="color:var(--grey-500)">vom Nettoumsatz</p>
        </div>
      </div>

      <p class="terms-note">
        <b>Enthalten in der Einstiegsgebühr:</b> Gebietsschutz · Schulung · Markenlizenz · Systemeinführung ·
        Softwarezugang · Vertriebsunterstützung.<br>
        <b>Weitere Investitionen:</b> Fahrzeug (Leasing oder Miete) · Reinigungsmaschinen und Spezialtechnik ·
        Reinigungsmittel-Lager.
      </p>

      <h3 class="display" style="margin-top:44px;margin-bottom:6px">Erfolgsrechnung (Richtwerte)</h3>
      <div class="ledger">
        <div class="ledger-row"><span>Nettojahresumsatz (geplant)</span><span class="v">400.000 €</span></div>
        <div class="ledger-row"><span>Materialaufwand</span><span class="v">20.000 €</span></div>
        <div class="ledger-row"><span>Personalaufwand</span><span class="v">140.000 €</span></div>
        <div class="ledger-row"><span>Fahrzeug / Maschinen Leasing</span><span class="v">20.000 €</span></div>
        <div class="ledger-row"><span>Betriebsbedarf / Versicherung</span><span class="v">12.000 €</span></div>
        <div class="ledger-row"><span>Werbung / Marketing</span><span class="v">12.000 €</span></div>
        <div class="ledger-row"><span>Franchisegebühr (8 %)</span><span class="v">32.000 €</span></div>
        <div class="ledger-row"><span>Marketingbeitrag (3 %)</span><span class="v">12.000 €</span></div>
        <div class="ledger-row total"><span>Gesamtkosten</span><span class="v">248.000 €</span></div>
        <div class="ledger-row total"><span>Betriebsergebnis vor Steuer</span><span class="v">152.000 €</span></div>
      </div>
      <p class="ledger-disclaimer">
        Ungefähre Richtwerte auf Basis eines Modellbetriebs. Keine Zusicherung eines bestimmten Ergebnisses. Die
        tatsächlichen Zahlen hängen von Region, Auftragslage und Betriebsführung ab. Details im Businessplan.
      </p>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="band reveal">
    <div class="wrap" style="text-align:center">
      <h2 class="display">Wie viele Gebiete noch frei sind,<br>hängt vom Bundesland ab.</h2>
      <div class="hero-cta" style="justify-content:center;margin-top:22px">
        <a class="btn" href="#regionen">Unterlagen anfordern</a>
        <a class="btn btn--outline" href="#konditionen">Konditionen ansehen</a>
      </div>
    </div>
  </section>

  <!-- REGION-AUSWAHL -->
  <TileSelect
    id="regionen"
    heading="In welcher Region möchtest du dich bewerben?"
    lead="Wähle ein oder mehrere Bundesländer aus — wir sagen dir, welche Region noch frei ist."
    note="Diese Anfrage ist noch nicht verbindlich."
    items={regionen}
    tilesModifier="tiles--3col"
    orderTitle="Deine Regionen"
    emptyText="Noch keine Region ausgewählt. Tippe oben auf die Bundesländer, in denen du dich bewerben möchtest."
    unitSingular="Region"
    unitPlural="Regionen"
    itemStatusText="ausgewählt"
    idleButtonText="Region auswählen"
    activeButtonTemplate="Diese {n} {unit} übernehmen"
    helperText="Unverbindlich – der nächste Schritt ist das Bewerbungsformular."
    targetSectionId="bewerbung"
    targetFocusId="bfName"
    targetChipsId="bewerbungChips"
  />

  <!-- BEWERBUNGSFORMULAR -->
  <FranchiseBewerbung />

</Layout>
