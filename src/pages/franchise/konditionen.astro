---
import Layout from '../../layouts/Layout.astro';
import { brand } from '../../config/brand';

const base = import.meta.env.BASE_URL;
---
<Layout
  title={`Franchisekonditionen – ${brand.name}`}
  description="Einstiegsgebühr, laufende Franchisegebühr, Marketingbeitrag und eine beispielhafte Erfolgsrechnung für 123Reinigung Franchise-Partner."
  ctaLabel="Bewerbung starten"
  ctaHref={`${base}franchise#regionen`}
  stickyCtaLabel="Bewerbung starten"
  stickyCtaHref={`${base}franchise#regionen`}
>
  <section class="hero hero--schmal">
    <div class="wrap">
      <div class="hero-content">
        <p class="eyebrow">Franchise</p>
        <h1 class="display">Franchisekonditionen im Detail.</h1>
        <p class="hero-sub">Die Lizenzkosten im Überblick — final abgestimmt werden sie im persönlichen Gespräch.</p>
      </div>
    </div>
  </section>

  <section class="band reveal">
    <div class="wrap">
      <div class="rule"></div>
      <h2 class="display">Franchisekonditionen &amp; Kosten</h2>

      <div class="terms">
        <div>
          <p class="lbl">Einstiegsgebühr</p>
          <p class="val">40.000 €</p>
          <p class="hint" style="color:var(--grey-500)">netto, einmalig</p>
        </div>
        <div>
          <p class="lbl">Laufende Franchisegebühr</p>
          <p class="val">8 %</p>
          <p class="hint" style="color:var(--grey-500)">vom Nettoumsatz</p>
        </div>
        <div>
          <p class="lbl">Marketingbeitrag</p>
          <p class="val">3 %</p>
          <p class="hint" style="color:var(--grey-500)">vom Nettoumsatz</p>
        </div>
      </div>

      <p class="terms-note">
        <b>Enthalten in der Einstiegsgebühr:</b> Gebietsschutz · Schulung · Markenlizenz · Systemeinführung ·
        Softwarezugang · Vertriebsunterstützung.<br>
        <b>Weitere Investitionen:</b> Fahrzeug (Leasing oder Miete) · Reinigungsmaschinen und Spezialtechnik ·
        Reinigungsmittel-Lager.
      </p>

      <h3 class="display" style="margin-top:44px;margin-bottom:6px">Erfolgsrechnung (Richtwerte)</h3>
      <div class="ledger">
        <div class="ledger-row"><span>Nettojahresumsatz (geplant)</span><span class="v">400.000 €</span></div>
        <div class="ledger-row"><span>Materialaufwand</span><span class="v">20.000 €</span></div>
        <div class="ledger-row"><span>Personalaufwand</span><span class="v">140.000 €</span></div>
        <div class="ledger-row"><span>Fahrzeug / Maschinen Leasing</span><span class="v">20.000 €</span></div>
        <div class="ledger-row"><span>Betriebsbedarf / Versicherung</span><span class="v">12.000 €</span></div>
        <div class="ledger-row"><span>Werbung / Marketing</span><span class="v">12.000 €</span></div>
        <div class="ledger-row"><span>Franchisegebühr (8 %)</span><span class="v">32.000 €</span></div>
        <div class="ledger-row"><span>Marketingbeitrag (3 %)</span><span class="v">12.000 €</span></div>
        <div class="ledger-row total"><span>Gesamtkosten</span><span class="v">248.000 €</span></div>
        <div class="ledger-row total"><span>Betriebsergebnis vor Steuer</span><span class="v">152.000 €</span></div>
      </div>
      <p class="ledger-disclaimer">
        Ungefähre Richtwerte auf Basis eines Modellbetriebs. Keine Zusicherung eines bestimmten Ergebnisses. Die
        tatsächlichen Zahlen hängen von Region, Auftragslage und Betriebsführung ab. Details im Businessplan.
      </p>

      <div class="hero-cta" style="margin-top:32px">
        <a class="btn" href={`${base}franchise#regionen`}>Jetzt bewerben</a>
        <a class="btn btn--outline" href={`${base}franchise`}>← Zurück zur Übersicht</a>
      </div>
    </div>
  </section>
</Layout>
