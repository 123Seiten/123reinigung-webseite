# --- HTTPS erzwingen ---
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://123reinigung.at/$1 [R=301,L]

# --- www auf Hauptdomain umleiten ---
RewriteCond %{HTTP_HOST} ^www\.123reinigung\.at$ [NC]
RewriteRule ^(.*)$ https://123reinigung.at/$1 [R=301,L]

# --- Sicherheitsheader ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Caching: Astro hasht Dateinamen in /_astro/, daher lange Haltbarkeit ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- Komprimierung ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# --- Konfiguration und Sperrlisten nicht ausliefern ---
<FilesMatch "^(mail-config\.php|mail-config\.example\.php|_rate-.*\.txt)$">
  Require all denied
</FilesMatch>

# --- PHPMailer-Verzeichnis nicht direkt aufrufbar ---
<IfModule mod_rewrite.c>
  RewriteRule ^lib/ - [F,L]
</IfModule>

# --- Uploadgrenzen ---
php_value upload_max_filesize 12M
php_value post_max_size 25M
php_value max_file_uploads 12
php_value memory_limit 128M
